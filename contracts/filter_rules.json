      "then": {
        "action": "junk",
        "confidence": 0.95,
        "reason": "asks an unknown sender's link recipient to install an app",
        "sub_action": "none"
      },
      "when": {
        "any": [
          "apk",
          "install app",
          "download app"
        ],
        "sender_kinds": [
          "personal_mobile",
          "unknown",
          "shortcode"
        ]
      }
    },
