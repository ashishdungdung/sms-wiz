      "when": {
        "any": [
          "unsubscribe",
          "t&c apply",
          "t&c",
          "% off",
          "sale ends",
          "flat off"
        ],
        "none": [
          "debited",
          "credited",
          "otp",
          "due"
        ]
      }
    }
  ],
  "syntax": "sms-wiz.filter/v1",
  "version": 1
}
